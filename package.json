{
  "name": "rankroom",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "tsc -p packages/shared/tsconfig.build.json && vite build --config apps/web/vite.config.ts && tsx apps/server/src/index.ts",
    "dev:server": "tsx watch apps/server/src/index.ts",
    "dev:web": "vite --config apps/web/vite.config.ts --port=5173 --host=0.0.0.0",
    "build": "tsc -p packages/shared/tsconfig.build.json && tsc -p apps/server/tsconfig.json && vite build --config apps/web/vite.config.ts",
    "start": "NODE_ENV=production node apps/server/dist/index.js",
    "test": "vitest run --config packages/shared/vitest.config.ts && vitest run --config apps/server/vitest.config.ts",
    "lint": "tsc --noEmit -p packages/shared/tsconfig.json && tsc --noEmit -p apps/server/tsconfig.typecheck.json && tsc --noEmit -p apps/web/tsconfig.json",
    "clean": "rm -rf packages/shared/dist apps/server/dist apps/web/dist"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/multipart": "^10.1.8",
    "@fastify/static": "^10.1.11",
    "@google/genai": "^2.4.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@vitejs/plugin-react": "^6.1.1",
    "better-sqlite3": "^13.2.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.4",
    "express": "^4.21.2",
    "fastify": "^5.12.8",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "vite": "^8.3.0",
    "vitest": "^5.1.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  },
  "trustedDependencies": [
    "better-sqlite3",
    "sharp",
    "esbuild"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "sharp",
      "esbuild"
    ]
  }
}
