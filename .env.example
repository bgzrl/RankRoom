# Port et adresse d'écoute du serveur Fastify (derrière le reverse proxy réseau)
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Répertoire isolé de persistance (base SQLite WAL + images .webp uploadées)
# En installation native LXC : /var/lib/rankroom
# En Docker : /data
DATA_DIR=./data

# URL publique exposée par votre reverse proxy (utilisée pour le CORS HTTP & Socket.IO)
# Laisser vide en local ; renseigner en production (sans slash final).
PUBLIC_URL=https://rankroom.exemple.fr

# Taille maximale autorisée par image uploadée (en Mo, entre 1 et 25)
MAX_UPLOAD_SIZE_MB=5

# Mot de passe optionnel protégeant la création, modification et suppression des thèmes.
# Laisser vide pour autoriser tout le monde à gérer les thèmes.
ADMIN_PASSWORD=
